{
  "schema": "sd-factory-render-lane-contract/v1",
  "created_at": "2026-05-03",
  "period": "2026-Q2",
  "goal": {
    "monthly_decks": 9,
    "director_registry": "scripts/_directors.py",
    "production_system": "sales-ops-copilot",
    "research_system": "tc-aicore"
  },
  "decision": {
    "factory_mode": "compute_and_bind",
    "production_substrate": ".ppttc via ppttc.exe plus Excel COM table-image updates",
    "llm_role": "GPT-5.5-preferred upstream planner and narrative generator; generated text must be evidence-grounded and cached before binding",
    "tc_ai_role": "optional GPT-5.5-assisted ribbon refinement surface; not a monthly factory dependency unless accepted outputs are cached and gate-checked"
  },
  "global_gates": [
    "explicit ARR/ACV separation",
    "Type filter on every Type-bearing fact",
    "headline currency via Salesforce report converted aggregates or audited converted workbook values",
    "named-element contract validation before rendering",
    "bound-package assertions after rendering",
    "rendered-slide visual sanity",
    "regional publish gate before leadership use"
  ],
  "lanes": {
    "ppttc_text_binding": {
      "production_allowed": true,
      "description": "Deterministic text field binding into a manually named think-cell seed/template."
    },
    "ppttc_named_seed_native_chart": {
      "production_allowed": true,
      "description": "Named think-cell chart/table payload rendered by ppttc.exe. Requires pre-existing named elements and package proof."
    },
    "excel_com_table_image": {
      "production_allowed": true,
      "description": "Excel COM UpdateBatch/AddRangeImage table-image lane for table-shaped artifacts."
    },
    "powerpoint_com_merge": {
      "production_allowed": true,
      "description": "Controlled PowerPoint COM merge of proven bound components into branded LAND decks."
    },
    "python_ole_splice_fallback": {
      "production_allowed": false,
      "description": "Mac-side fallback/research lane. Useful for tc-aicore experiments, not production until it passes the same gates."
    },
    "llm_cached_upstream": {
      "production_allowed": false,
      "description": "Narrative/chart-class generation before binding. Never the rendering lane and never an uncached source of truth."
    },
    "gpt55_assisted_tc_ai_ribbon": {
      "production_allowed": false,
      "description": "Human-in-the-loop ribbon refinement where GPT-5.5 prepares prompts, critiques tc.ai output, and captures accepted wording back into the run artifact."
    },
    "tc_ai_interactive_only": {
      "production_allowed": false,
      "description": "think-cell AI ribbon workflow for one-off interactive use. Not reproducible enough for monthly production."
    }
  },
