  "capabilities": [
    {
      "id": "python_orchestration",
      "status": "production",
      "entrypoints": [
        "scripts/build_thinkcell_visual_contract_plan.py",
        "scripts/build_thinkcell_build_scaffold.py",
        "scripts/run_thinkcell_windows_bridge.py",
        "scripts/run_thinkcell_insertion_pilot.py",
        "scripts/build_regional_meeting_spine_decks.py"
      ],
      "production_rule": "Own graph, visual-plan, proof resolution, Windows bridge orchestration, and deck assembly. Do not synthesize fake think-cell charts."
    },
    {
      "id": "tcrender",
      "status": "production",
      "entrypoints": [
        "libs/tcrender/tcrender/render.py",
        "tcrender.TcRenderClient.render",
        "scripts/build_ppttc_demo.py"
      ],
      "production_rule": "Default Mac-side render client for .ppttc to .pptx through VM ppttc.exe. New sales-ops factory code should call this instead of ad hoc bridge wrappers."
    },
    {
      "id": "ppttc_windows_bridge",
      "status": "production",
      "entrypoints": [
        "scripts/run_thinkcell_windows_bridge.py",
        "scripts/thinkcell_windows_bridge.ps1",
        "C:\\Program Files (x86)\\think-cell\\ppttc.exe"
      ],
      "production_rule": "Use for named native think-cell chart and automation text updates against proven donor or seed PPTX files."
    },
    {
      "id": "tc_com_driver",
      "status": "production",
      "entrypoints": [
        "libs/tc_com_driver",
        "ThinkCellClient.connect",
        "UpdateBatch"
      ],
      "production_rule": "Use as the wrapped vendor COM surface for PowerPoint and Excel think-cell automation, especially UpdateBatch and diagnostics."
    },
    {
      "id": "excel_com_updatebatch",
      "status": "production",
      "entrypoints": [
        "tcXlAddIn.CreateUpdate",
        "tcUpdate.AddRangeData",
        "tcUpdate.AddRangeImage",
        "tcUpdate.Send"
      ],
      "production_rule": "Use AddRangeImage for table-image lanes and AddRangeData only when a named target already exists."
    },
    {
      "id": "tcxml",
      "status": "production",
      "entrypoints": [
        "libs/tcxml",
        "extract_thinkcell_streams",
        "parse_thinkcell_xml",
        "serialize_thinkcell_xml"
      ],
      "production_rule": "Use for think-cellXML inspection, contract proofing, and guardrails. Do not make direct CFB authoring the primary path until packaging is complete."
    },
    {
      "id": "vba_macro_host",
      "status": "supported_host",
      "entrypoints": [
        "Application.COMAddIns(\"thinkcell.addin\").Object"
      ],
      "production_rule": "Valid host for the same late-bound COM calls; useful for operator macros and probes, not a separate lane."
    },
    {
      "id": "csharp_dotnet_interop_host",
      "status": "supported_host",
      "entrypoints": [
        "scripts/generate_thinkcell_csharp_interop.py",
        "Microsoft Office type libraries",
        "dynamic tcXlAddIn",
        "dynamic tcPpAddIn"
      ],
      "production_rule": "Candidate host for a durable Windows worker after the Python bridge contract is stable."
    },
    {
      "id": "tc_toolkit_aicore",
      "status": "optional_proof_candidate",
      "entrypoints": [
        "/Users/test/code/labs/tc_toolkit/tc_toolkit/aicore.py",
        "AICoreClient",
        "Socket.IO over WSS"
      ],
      "production_rule": "Optional upstream enrichment for action titles, research, and chart suggestions. Do not use as a blocking source for SimCorp financial facts or ARR/ACV metrics."
    },
    {
      "id": "powerpoint_com_step3",
      "status": "observed_uninvoked",
      "entrypoints": [
        "tcPpAddIn.PresentationFromTemplateStep3",
        "tcPpAddIn.UpdateChartStep3",
        "tcPpAddIn.UpdateBatchStep3"
      ],
      "production_rule": "Do not call directly from the factory until a method-specific proof lane exists; ppttc.exe wraps the stable path today."
    },
    {
      "id": "named_donor_seed_patching",
      "status": "production",
      "entrypoints": [
        "scripts/ppttc_template.py",
        "scripts/thinkcell_cfb.py",
        "scripts/prove_thinkcell_stock_donor_contract.py",
        "scripts/prove_thinkcell_native_chart_contract.py"
      ],
      "production_rule": "Convert stock donor material into named SimCorp update surfaces only with binding proof and render evidence."
    },
    {
      "id": "table_image_donor",
      "status": "production",
      "entrypoints": [
        "assets/LAND_thinkcell_table_image_donor.pptx",
        "state/thinkcell_bridge/table_image_donors",
        "Excel COM AddRangeImage"
      ],
      "production_rule": "Use for dense table-shaped artifacts. Treat output as linked table image, not native editable think-cell table."
    },
    {
      "id": "style_api",
      "status": "proof_candidate",
      "entrypoints": [
        "tcPpAddIn.LoadStyle",
        "tcPpAddIn.LoadStyleForRegion",
        "tcPpAddIn.GetStyleName",
        "tcPpAddIn.RemoveStyles"
      ],
      "production_rule": "Runtime-proven on transient decks; needs SimCorp brand-style decision record before production use."
    },
    {
      "id": "excel_presentation_from_template",
      "status": "proof_candidate",
      "entrypoints": [
        "tcXlAddIn.PresentationFromTemplate"
      ],
      "production_rule": "Consider only if a future SimCorp seed is fully Excel-linked. Current native chart lane uses ppttc.exe."
    },
    {
      "id": "tcserver_http",
      "status": "optional_proof_candidate",
      "entrypoints": [
        "C:\\Program Files (x86)\\think-cell\\tcserver.exe"
      ],
      "production_rule": "Do not start/register unattended. Promote only after explicit server-mode architecture decision."
    },
    {
      "id": "interactive_start_table_insertion",
      "status": "research_only",
      "entrypoints": [
        "tcPpAddIn.StartTableInsertion",
        "scripts/run_thinkcell_interactive_com_ui_probe.py"
      ],
      "production_rule": "Positive for creating unnamed CSmartGrid objects; not bindable or production-safe until naming and update proof passes."
    },
    {
      "id": "native_editable_thinkcell_tables",
      "status": "blocked",
      "entrypoints": [
        "CSmartGrid",
        "CContainerSE"
      ],
      "production_rule": "Blocked until a clean named native table donor binds without repair prompts. Use table-image lane."
    },
    {
      "id": "direct_arbitrary_chart_creation",
      "status": "not_found",
      "entrypoints": [],
      "production_rule": "No public CreateChart or InsertChart COM method found. Use donor or seed objects."
    },
    {
      "id": "deep_reverse_engineering",
      "status": "research_only",
      "entrypoints": [
        "state/thinkcell_bridge/ghidra_decompile",
        "scripts/frida_handlers",
        "state/thinkcell_bridge/typeinfo",
        "state/thinkcell_bridge/phase12_auth_capture"
      ],
      "production_rule": "Discovery only unless converted into a named proof lane with render and package assertions."
    }
  ],
