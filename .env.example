# sales-ops-copilot uses az CLI + sf CLI auth — no app-level secrets needed by default.
# This .env.example is here only for future overrides:

# Override the Azure OpenAI endpoint (default is hardcoded for apro-openai)
# AZURE_OPENAI_ENDPOINT=https://apro-openai.openai.azure.com/

# Override the Azure OpenAI API version
# AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Override default deployment
# AZURE_OPENAI_DEFAULT_DEPLOYMENT=gpt53chat
